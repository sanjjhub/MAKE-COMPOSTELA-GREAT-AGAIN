# Normaliza saltos de linea: LF dentro del repo, nativos en el disco.
# Evita diffs enteros que solo cambian CRLF por LF.
* text=auto

# Declarados explicitamente: con solo `text=auto` git los clasificaba por
# heuristica y podia acabar convirtiendo saltos de linea dentro de un binario.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.zip  binary
*.pdf  binary
*.mp4  binary
*.mov  binary
*.webm binary
*.mp3  binary
*.wav  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
